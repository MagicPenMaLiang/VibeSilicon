# Risk-register template (per IP / per phase). Review each example before use.
#
# Usage: copy templates/risk_register.yaml.template into the private project documentation.
# Track quality-gate failures and independent reviewer findings.
# Applicable throughout the project lifecycle.

metadata:
  phase: <Phase X>
  module: <module_name | all>
  version: v1.0
  date: <ISO8601>
  owner: <human_name>

# Risk entries.
risks:

  # Example risks; replace assumptions with project evidence.
  - id: R001
    category: bit_width
    severity: critical
    description: "Incorrect numeric widths cause C-simulation mismatches"
    source: "AGENTS.md numeric-contract rules"
    likelihood: medium
    impact: high
    detection: "Bit-exact golden comparison and reviewed numeric boundaries"
    mitigation: |
      - Declare logical widths, signedness and Q_FRAC in spec.md.
      - Compare the implementation plan with the frozen golden reference.
      - Include zero and maximum-value boundary vectors.
    owner: coder-fpga
    status: monitoring

  - id: R002
    category: cdc
    severity: critical
    description: "Unsafe clock-domain crossings can cause metastability or incoherent transfers"
    source: "skills/fpga-cdc-check/SKILL.md"
    likelihood: high
    impact: critical
    detection: "Quality Gate ⑤ Vivado report_cdc"
    mitigation: |
      - Use a reviewed synchronizer with ASYNC_REG where applicable.
      - Use a reviewed coherent handshake or asynchronous FIFO for multi-bit data.
      - Obtain required human approval for CDC, reset and PHY assumptions.
    owner: coder-fpga + reviewer-fpga
    status: monitoring

  - id: R003
    category: resource
    severity: major
    description: "On-chip storage utilization exceeds the reviewed project limit"
    source: "skills/fpga-resource-optimization/SKILL.md"
    likelihood: high
    impact: high
    detection: "Source-bound synthesis and implementation resource reports"
    mitigation: |
      1. Width reduction (18-bit -> 12-bit) requires an approved numeric-contract change.
      2. Evaluate URAM migration (BIND_STORAGE impl=URAM) against reviewed target semantics.
      3. Evaluate bounded ARRAY_PARTITION (factor=2/4) against port demand and capacity.
      4. Evaluate DDR/SRAM time multiplexing with bandwidth and latency evidence.
      5. Keep XPM_RAM variants behind reviewed memory wrappers.
      6. Review supported memory-port optimization for the selected tool version.
      7. Use reviewed XPM crossing macros only for applicable CDC requirements.
      8. Track routing congestion and timing non-regression.
    owner: coder-fpga
    status: monitored

  - id: R004
    category: timing
    severity: major
    description: "Negative WNS indicates a setup timing violation"
    source: "skills/fpga-timing-closure/SKILL.md"
    likelihood: medium
    impact: high
    detection: "Quality Gate ④ Vivado report_timing_summary"
    mitigation: |
      - Evaluate a pipeline change while preserving reviewed latency and alignment.
      - Evaluate splitting a diagnosed combinational path.
      - Review create_clock against the accepted frequency requirement.
      - Compare implementation strategies in a controlled experiment.
    owner: coder-fpga
    status: monitoring

  - id: R005
    category: ai_iteration
    severity: minor
    description: "Coder still reports FAIL after three iterations"
    source: "failure_handling.max_iterations"
    likelihood: medium
    impact: medium
    detection: "Recorded iteration count"
    mitigation: |
      - Escalate to the project owner and independent reviewer.
      - Check the completeness of spec.md.
      - Review the immutable Python golden-reference contract.
    owner: orchestrator-fpga
    status: monitored

  - id: R006
    category: l33_signoff
    severity: critical
    description: "Missing required human sign-off for PHY, reset or security"
    source: "AGENTS.md human-review rules"
    likelihood: low
    impact: critical
    detection: "Review evidence-bound approval records against the applicable sign-off schema"
    mitigation: |
      - Block downstream acceptance until an authorized human approves.
      - Use schemas/rtl_quality_signoff.schema.json and applicable target contracts.
      - Verify reviewer identity and evidence; file existence or signed=true is insufficient.
    owner: human (Phase Owner)
    status: blocking

  - id: R007
    category: golden_ref
    severity: major
    description: "An incorrect Python golden reference can produce false simulation confidence"
    source: "AGENTS.md immutable-golden rules"
    likelihood: low
    impact: critical
    detection: "Project owner and independent reviewer inspect golden-reference evidence"
    mitigation: |
      - Have the golden boundary reviewed by the responsible engineer.
      - Keep accepted golden references read-only unless an explicit reviewed change is authorized.
      - Record known model limitations in the private project evidence.
    owner: human (Phase Owner)
    status: monitored

  - id: R008
    category: tool_chain
    severity: minor
    description: "Windows EDA tool environment initialization fails"
    source: "opencode.json mcpServers.*.env"
    likelihood: medium
    impact: high
    detection: "MCP launcher logs and tool-availability probes"
    mitigation: |
      - Check the selected settings64.bat and installed tool version.
      - Keep personal installation paths in ignored local environment settings.
      - Use the supported MCP launcher and its tool-selection environment.
    owner: coder-fpga + orchestrator-fpga
    status: monitored

  - id: R009
    category: baseline_drift
    severity: minor
    description: "Savings claims use an incompatible or incorrectly selected baseline"
    source: "templates/baseline_report.md.template"
    likelihood: medium
    impact: medium
    detection: "Project owner reviews the baseline report and source measurements"
    mitigation: |
      - Select an applicable baseline and record its limitations.
      - State the comparison formula, units and compatible configuration.
      - Separate cross-tool agreement from correctness and measured human-effort savings.
    owner: human (Phase Owner)
    status: monitored

  - id: R010
    category: data_leak
    severity: critical
    description: "Private specifications are sent to an unauthorized public model service"
    source: "AGENTS.md ownership and confidentiality rules"
    likelihood: low
    impact: critical
    detection: "Data-handling audit and approved deployment review"
    mitigation: |
      - Use the project-approved deployment and data-handling boundary.
      - Do not send private specifications to an unauthorized service.
      - Review data handling at the declared security-audit cadence.
    owner: human (Security Owner)
    status: monitored

# Illustrative risk summary; recompute from the actual entries and statuses.
summary:
  total: 10
  by_severity:
    critical: 4
    major: 3
    minor: 3
  by_status:
    monitoring: 8
    monitored: 0
    blocking: 1
    mitigated: 1

# Escalation path.
escalation:
  trigger: "Any critical risk is triggered OR Quality Gate FAIL exceeds three iterations"
  path: "Coder → Reviewer L3.1 → Phase Owner"
  max_iterations: 3
