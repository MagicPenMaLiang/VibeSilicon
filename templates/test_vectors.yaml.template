# 测试向量 + 黄金参考模板（per IP）
#
# 用法：cp docs/templates/test_vectors.yaml.template tests/vectors/<module>.yaml
# 配合 python-sim-mcp load_vectors 工具读取
# SPI Pilot 示例见计划 §3.4（≥ 10 个测试向量）

metadata:
  module: <module_name>          # 例：counter, packet_filter
  type: <phy/timing | algorithm | mixed>
  version: v1.0
  test_count: <N>                # 必须 ≥ 10（计划 §3.5 验收）
  golden_ref: reference/golden/<module>.py

# 输入约束（与 spec.md 接口表对齐）
input_schema:
  signals:
    - name: x
      bit_width: 8
      q_frac: 0                  # Q0.8 整数
    - name: g
      bit_width: 8
      q_frac: 0
  # 其他信号...

# 输出约束
output_schema:
  signals:
    - name: y
      bit_width: 8
      q_frac: 0
  # 其他信号...

# 测试用例（黄金参考数据）
test_cases:
  - id: tc_01_basic
    description: 基础乘法（100 * 128 = 12800 >> 8 = 50）
    inputs:
      x: 100
      g: 128
    expected_outputs:
      y: 50
    golden_source: |
      # 与 reference/golden/<module>.py 等价
      (x * g) >> 8

  - id: tc_02_boundary_zero
    description: 边界：x = 0
    inputs:
      x: 0
      g: 128
    expected_outputs:
      y: 0

  - id: tc_03_boundary_max
    description: 边界：x = 255
    inputs:
      x: 255
      g: 255
    expected_outputs:
      y: 254

  - id: tc_04_zero_gain
    description: 边界：g = 0
    inputs:
      x: 128
      g: 0
    expected_outputs:
      y: 0

  # ... 至少 10 个测试向量

# 随机测试（可选）
random_tests:
  count: 100
  seed: 42
  input_ranges:
    x: [0, 255]
    g: [0, 255]
  expected_outputs:
    source: <module>_ref.compute(x, g)

# 验证判据
pass_criteria:
  csim_diff_zero: true          # C-Sim 与 Python bit-match
  tolerance:
    rtol: 0                     # 严格 bit-match
    atol: 0
  failure_threshold: 0          # 0 个失败即 PASS

# 错误注入（可选，验证鲁棒性）
fault_injection:
  - name: bit_flip
    probability: 0.01
    target_signals: [x, g]
  - name: clock_glitch
    duration_ns: 5

# 关联文档
references:
  spec: docs/spec/<module>.md
  golden_ref: reference/golden/<module>.py
  testbench_cpp: src/<module>/testbench.cpp
  hls_script: src/<module>/run_csim.tcl
