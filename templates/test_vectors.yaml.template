# Test-vector and golden-reference template (per IP).
#
# Usage: copy templates/test_vectors.yaml.template into the private project vector directory.
# The python-sim-mcp load_vectors tool loads YAML as data; it does not execute expressions.
# Example vectors below are illustrative; select coverage from the accepted verification plan.

metadata:
  module: <module_name>          # Example: counter, packet_filter
  type: <phy/timing | algorithm | mixed>
  version: v1.0
  test_count: <N>                # Replace with the actual reviewed vector count
  golden_ref: reference/golden/<module>.py

# Input contract: align it with the specification's numeric and interface tables.
input_schema:
  signals:
    - name: x
      bit_width: 8
      q_frac: 0                  # Unsigned integer input storage in this example
    - name: g
      bit_width: 8
      q_frac: 0
  # Add other declared input signals.

# Output contract.
output_schema:
  signals:
    - name: y
      bit_width: 8
      q_frac: 0
  # Add other declared output signals.

# Test cases containing frozen expected values.
test_cases:
  - id: tc_01_basic
    description: Basic multiply and shift (100 * 128 = 12800 >> 8 = 50)
    inputs:
      x: 100
      g: 128
    expected_outputs:
      y: 50
    golden_source: |
      # Equivalent to the reviewed reference/golden/<module>.py expression.
      (x * g) >> 8

  - id: tc_02_boundary_zero
    description: Boundary x = 0
    inputs:
      x: 0
      g: 128
    expected_outputs:
      y: 0

  - id: tc_03_boundary_max
    description: Boundary x = 255
    inputs:
      x: 255
      g: 255
    expected_outputs:
      y: 254

  - id: tc_04_zero_gain
    description: Boundary g = 0
    inputs:
      x: 128
      g: 0
    expected_outputs:
      y: 0

  # Add cases required by the accepted verification plan.

# Optional random tests.
random_tests:
  count: 100
  seed: 42
  input_ranges:
    x: [0, 255]
    g: [0, 255]
  expected_outputs:
    source: <module>_ref.compute(x, g)

# Acceptance criteria.
pass_criteria:
  csim_diff_zero: true          # Bit-exact C-simulation comparison against Python
  tolerance:
    rtol: 0                     # Exact comparison
    atol: 0
  failure_threshold: 0          # PASS requires zero failures

# Optional fault injection for the project's robustness contract.
fault_injection:
  - name: bit_flip
    probability: 0.01
    target_signals: [x, g]
  - name: clock_glitch
    duration_ns: 5

# Related project documents.
references:
  spec: docs/spec/<module>.md
  golden_ref: reference/golden/<module>.py
  testbench_cpp: src/<module>/testbench.cpp
  hls_script: src/<module>/run_csim.tcl
