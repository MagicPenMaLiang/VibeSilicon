{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pre-registered offline benefit-trial plan; not a benefit claim or hardware authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trial_id", "registered_date", "rubric", "success_condition", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "trial_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "registered_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "rubric": {"const": "docs/design/debug_learning/benefit_metrics.md"},
    "success_condition": {
      "type": "object", "additionalProperties": false,
      "required": ["improved_metrics", "max_overreach", "min_pairs", "require_g1_non_regression"],
      "properties": {
        "improved_metrics": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["m1", "m2", "m4", "m5"]}
        },
        "max_overreach": {"const": 0},
        "min_pairs": {"type": "integer", "minimum": 1, "maximum": 512},
        "require_g1_non_regression": {"type": "boolean"}
      }
    },
    "decisions": {
      "type": "array", "minItems": 2, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "arm", "held_out", "blind_token"],
        "properties": {
          "pair_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "arm": {"enum": ["control", "treatment"]},
          "held_out": {"type": "boolean"},
          "blind_token": {"type": "string", "pattern": "^[a-f0-9]{16,64}$"}
        }
      }
    }
  }
}
