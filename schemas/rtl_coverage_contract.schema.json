{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verilator instrumented-line coverage contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "backend", "metric", "scope", "minimum_percent", "simulation_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"const": "verilator"},
    "metric": {"const": "line"},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "minimum_percent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
    "simulation_contract": {"type": "string", "minLength": 1}
  }
}
