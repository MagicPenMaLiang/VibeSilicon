{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/rtl_quality_rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "standard_version", "catalog_id", "profiles", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "standard_version": {"type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$"},
    "catalog_id": {"type": "string", "minLength": 1},
    "profiles": {"type": "array", "uniqueItems": true, "items": {"enum": ["fpga", "asic", "handwritten", "generated"]}, "minItems": 4, "maxItems": 4},
    "rules": {"type": "array", "minItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["id", "family", "level", "severity", "verification", "profiles", "evidence", "summary"], "properties": {
      "id": {"type": "string", "pattern": "^RTL-(R[0-9]{3}|[A-Z]{3,4}-[0-9]{3})$"},
      "family": {"enum": ["RTL-GEN", "RTL-NAM", "RTL-TYP", "RTL-CMB", "RTL-SEQ", "RTL-FSM", "RTL-RST", "RTL-CDC", "RTL-IFC", "RTL-CLK", "RTL-MEM", "RTL-XPR", "RTL-VER", "RTL-DBG", "RTL-MNT"]},
      "level": {"enum": ["MUST", "SHOULD"]},
      "severity": {"enum": ["ERROR", "WARNING"]},
      "verification": {"enum": ["automated", "manual", "planned"]},
      "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fpga", "asic", "handwritten", "generated"]}},
      "evidence": {"type": "string", "minLength": 1},
      "summary": {"type": "string", "minLength": 1}
    }}}
  }
}
