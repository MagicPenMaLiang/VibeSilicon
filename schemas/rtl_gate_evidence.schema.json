{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/rtl_gate_evidence.schema.json",
  "title": "Unified RTL G0/G1/G2 evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "status", "evidence_id", "project", "stages", "annotation_count", "annotations_truncated", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_kind": {"const": "RTL_GATE_BUNDLE"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "evidence_id": {"$ref": "#/$defs/sha256"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "manifest_sha256", "target", "top"],
      "properties": {
        "manifest": {"$ref": "#/$defs/path"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "target": {"enum": ["fpga", "asic"]},
        "top": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"gate": {"const": "G0"}, "metrics": {"$ref": "#/$defs/g0_metrics"}, "annotations": {"maxItems": 0}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"gate": {"const": "G1"}, "metrics": {"$ref": "#/$defs/g1_metrics"}, "annotations": {"maxItems": 20}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"gate": {"const": "G2"}, "metrics": {"$ref": "#/$defs/g2_metrics"}, "annotations": {"maxItems": 0}}}]}
      ],
      "items": false
    },
    "annotation_count": {"type": "integer", "minimum": 0, "maximum": 20},
    "annotations_truncated": {"type": "integer", "minimum": 0},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"},
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "rule_id", "message_code", "file", "line", "column"],
      "properties": {
        "level": {"const": "warning"},
        "rule_id": {"type": "string", "pattern": "^VERILATOR-[A-Z][A-Z0-9_-]{2,53}$"},
        "message_code": {"const": "VERILATOR_WARNING"},
        "file": {"$ref": "#/$defs/path"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "evidence_id", "finding_count", "metrics", "annotations"],
      "properties": {
        "gate": {"enum": ["G0", "G1", "G2"]},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
        "evidence_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "finding_count": {"type": "integer", "minimum": 0},
        "metrics": {"type": "object"},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
      }
    },
    "g0_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_sha256", "waiver_sha256", "sources_checked", "waivers_checked"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "waiver_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "sources_checked": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "waivers_checked": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "g1_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["source_set_sha256", "tool", "returncode"],
      "properties": {
        "source_set_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "tool": {"oneOf": [{"$ref": "#/$defs/tool"}, {"type": "null"}]},
        "returncode": {"oneOf": [{"type": "integer"}, {"type": "null"}]}
      }
    },
    "g2_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["smoke_evidence_id", "compile", "run", "pass_token_count"],
      "properties": {
        "smoke_evidence_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "compile": {"oneOf": [{"enum": ["PASS", "FAIL", "TIMEOUT", "ERROR", "NOT_RUN"]}, {"type": "null"}]},
        "run": {"oneOf": [{"enum": ["PASS", "FAIL", "TIMEOUT", "ERROR", "NOT_RUN"]}, {"type": "null"}]},
        "pass_token_count": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}
      }
    },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"const": "verilator"}, "version": {"type": "string", "minLength": 1}}
    }
  }
}
