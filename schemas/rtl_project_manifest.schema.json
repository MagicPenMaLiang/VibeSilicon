{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/rtl_project_manifest.schema.json",
  "title": "VibeSilicon RTL project manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_root", "target", "source_kinds", "top", "source_roots", "sources", "headers", "include_dirs", "defines", "parameters", "clocks", "resets"],
  "properties": {
    "schema_version": {"const": 1},
    "project_root": {"$ref": "#/$defs/path"},
    "target": {"enum": ["fpga", "asic"]},
    "source_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["handwritten", "generated"]}},
    "top": {"$ref": "#/$defs/identifier"},
    "source_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "headers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "include_dirs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
    "defines": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_+'-]+$"}},
    "parameters": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"}, "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_+'-]+$"}},
    "clocks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "resets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\:]+$"}
  }
}
