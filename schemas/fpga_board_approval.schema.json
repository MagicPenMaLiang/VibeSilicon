{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Externally pinned operation-specific human approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "operator",
    "reviewer",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operator": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
