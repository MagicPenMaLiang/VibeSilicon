{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/rtl_generator_provenance.schema.json",
  "title": "Generated RTL provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator", "generated_sources", "reproducible", "generated_by", "approved_by", "evidence_id"],
  "properties": {
    "schema_version": {"const": 1},
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "input_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "input_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "generated_sources": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}
      }
    },
    "reproducible": {"const": true},
    "generated_by": {"type": "string", "minLength": 1},
    "approved_by": {"type": "string", "minLength": 1},
    "evidence_id": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"}
  }
}
