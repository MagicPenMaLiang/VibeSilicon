{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/timing_change_proposal.schema.json",
  "title": "VibeSilicon Timing Change Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "analysis_evidence_id", "hypothesis", "changes", "constraints", "invariants", "required_gates", "max_iterations", "approval_status"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "pattern": "^TIMING-[A-Za-z0-9][A-Za-z0-9-]{2,63}$"},
    "analysis_evidence_id": {"$ref": "#/$defs/evidence"},
    "hypothesis": {"type": "string", "minLength": 1},
    "changes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change"}},
    "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
    "invariants": {"$ref": "#/$defs/uniqueStrings"},
    "required_gates": {"$ref": "#/$defs/uniqueStrings"},
    "max_iterations": {"type": "integer", "minimum": 1, "maximum": 3},
    "approval_status": {"enum": ["PENDING", "APPROVED"]}
  },
  "$defs": {
    "evidence": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "change": {
      "type": "object", "additionalProperties": false, "required": ["path", "kind", "description"],
      "properties": {"path": {"type": "string", "minLength": 1}, "kind": {"enum": ["rtl", "xdc", "strategy"]}, "description": {"type": "string", "minLength": 1}}
    },
    "constraint": {
      "type": "object", "additionalProperties": false, "required": ["type", "command", "from", "to", "proof_evidence_id"],
      "properties": {
        "type": {"enum": ["false_path", "clock_groups", "multicycle"]},
        "command": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "proof_evidence_id": {"$ref": "#/$defs/evidence"},
        "setup_cycles": {"type": "integer", "minimum": 2},
        "hold_cycles": {"type": "integer", "minimum": 1}
      }
    }
  }
}
