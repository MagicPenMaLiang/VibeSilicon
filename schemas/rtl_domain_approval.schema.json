{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/rtl_domain_approval.schema.json",
  "title": "RTL cross-domain human approval v1",
  "description": "Independent human acceptance of the CDC/RDC evidence for a multi-domain project. A tool PASS is not an engineering decision: this record is what turns it into one, and it is bound by content ID to the exact evidence it approves.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "top", "evidence_id", "approved_by", "approved_at_utc", "generated_by", "generated_at_utc", "approved_scope", "excluded_scope", "basis", "record_id"],
  "properties": {
    "schema_version": {"const": 1},
    "top": {"$ref": "#/$defs/identifier"},
    "evidence_id": {"$ref": "#/$defs/hash"},
    "approved_by": {"type": "string", "minLength": 1},
    "approved_at_utc": {"$ref": "#/$defs/timestamp"},
    "generated_by": {"type": "string", "minLength": 1},
    "generated_at_utc": {"$ref": "#/$defs/timestamp"},
    "approved_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "excluded_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "basis": {"type": "string", "minLength": 1},
    "record_id": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
