{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibesilicon.local/schemas/formal_assessment.schema.json",
  "title": "VibeSilicon Formal Applicability Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "top", "rtl_files", "change_kinds", "stateful", "latency_changed", "latency_contract", "clock_domains", "reset_model", "contains_cdc", "contains_vendor_ip", "blackbox_contracts", "properties", "assumptions", "tool", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "assessment_id": {"type": "string", "pattern": "^FORMAL-[A-Za-z0-9][A-Za-z0-9-]{2,63}$"},
    "top": {"type": "string", "minLength": 1},
    "rtl_files": {"$ref": "#/$defs/uniqueStrings"},
    "change_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["combinational_refactor", "arithmetic", "width_signedness", "sequential_refactor", "pipeline", "state_encoding", "state_machine", "protocol", "reset", "cdc", "constraint_only", "vendor_ip_update"]}},
    "stateful": {"type": "boolean"},
    "latency_changed": {"type": "boolean"},
    "latency_contract": {"type": ["string", "null"]},
    "clock_domains": {"type": "integer", "minimum": 1},
    "reset_model": {"enum": ["sync", "async", "mixed", "none"]},
    "contains_cdc": {"type": "boolean"},
    "contains_vendor_ip": {"type": "boolean"},
    "blackbox_contracts": {"type": "array", "items": {"$ref": "#/$defs/blackbox"}},
    "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "tool": {"$ref": "#/$defs/tool"},
    "result": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/result"}]}
  },
  "$defs": {
    "evidence": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "uniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "blackbox": {"type": "object", "additionalProperties": false, "required": ["instance", "contract", "evidence_id"], "properties": {"instance": {"type": "string", "minLength": 1}, "contract": {"type": "string", "minLength": 1}, "evidence_id": {"$ref": "#/$defs/evidence"}}},
    "property": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["assert", "cover"]}, "description": {"type": "string", "minLength": 1}}},
    "assumption": {"type": "object", "additionalProperties": false, "required": ["id", "description", "justification", "evidence_id"], "properties": {"id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "justification": {"type": "string", "minLength": 1}, "evidence_id": {"$ref": "#/$defs/evidence"}}},
    "tool": {"type": "object", "additionalProperties": false, "required": ["engine", "available", "version", "probe_evidence_id"], "properties": {"engine": {"type": "string", "minLength": 1}, "available": {"type": "boolean"}, "version": {"type": ["string", "null"]}, "probe_evidence_id": {"$ref": "#/$defs/evidence"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence_id", "modes_completed", "properties_proven", "covers_reached", "vacuity_checked", "proof_kind", "depth"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "ERROR", "INCONCLUSIVE"]},
        "evidence_id": {"type": ["string", "null"]},
        "modes_completed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "properties_proven": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "covers_reached": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "vacuity_checked": {"type": "boolean"},
        "proof_kind": {"enum": ["bounded", "unbounded"]},
        "depth": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
