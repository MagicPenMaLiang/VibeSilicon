{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibesilicon:schema:artifact-manifest:v1",
  "title": "VibeSilicon Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "project", "task_id", "created_at", "artifacts", "reproduce"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_id": {"$ref": "#/$defs/hash"},
    "project": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "reproduce": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "environment"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "size_bytes", "kind", "retention", "storage"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/hash"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "kind": {"$ref": "#/$defs/artifact_kind"},
        "retention": {"enum": ["transient", "pr", "milestone", "signoff"]},
        "storage": {"enum": ["repository", "artifact_store", "external"]},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "artifact_kind": {
      "enum": ["source", "spec", "constraints", "golden", "test_vector", "timing_report", "cdc_report", "utilization_report", "drc_report", "simulation_report", "log", "waveform", "dcp", "bitstream", "other"]
    }
  }
}
