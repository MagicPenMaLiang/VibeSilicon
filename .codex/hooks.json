{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/quality_gate/post_edit_hook.py --platform codex",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
